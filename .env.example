# ── AURALIS runtime database connection (Supabase) ─────────────────────────
# Transaction pooler (port 6543) — this is what the app uses at runtime.
# Format:
# postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Direct connection (port 5432) — used only by drizzle-kit migrations.
# Format:
# postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
DIRECT_URL=

# Demo seed data (sample products/orders/users + demo admin).
# Local development only. NEVER enable in production.
ALLOW_DEMO_SEED=false

# ── Control Center / freelance agent ───────────────────────────────────────
# You do NOT have to set any of the keys below on Vercel: open /control/settings
# in the dashboard, type them into the form and press save. They are stored
# encrypted (AES-256-GCM) in the app_settings table. Env vars, when present,
# still win — handy for rotation without a deploy.
# Telegram bot (BotFather → token). The bot is your approval channel.
TELEGRAM_BOT_TOKEN=
# Your numeric chat id (send /start to the bot, it answers with the id).
TELEGRAM_CHAT_ID=
# Optional shared secret; when set, the webhook only accepts Telegram calls
# carrying the matching X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=
# Public URL of this deployment (used for deep links + webhook registration).
APP_URL=
# Optional OpenAI-compatible model for proposal writing / translation.
# Without it the agent falls back to its built-in template + glossary engine.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
# Protects /api/control/agent/cron (Authorization: Bearer $CRON_SECRET).
CRON_SECRET=
# Optional: key used to encrypt the /control/settings values at rest.
# Falls back to a key derived from DATABASE_URL when empty.
APP_ENCRYPTION_KEY=
# Partner Supabase project used by the external job-discovery worker
# (saved from the dashboard as SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# USDT (TRC-20) payout address — also editable on /control/settings and /control/wallet.
TRC20_WALLET_ADDRESS=
# Signature shown at the end of generated proposals.
AGENT_AUTHOR_NAME=

# Optional: live dashboard refresh through Supabase Realtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
